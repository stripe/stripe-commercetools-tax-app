{
  "key": "${ctpTaxCalculatorExtensionKey}",
  "destination": {
    "type": "HTTP",
    "url": "${ctpExtensionBaseUrl}"
  },
  "triggers": [
    {
      "resourceTypeId": "cart",
      "actions": ["Update", "Create"],
      "condition": "taxMode=\"ExternalAmount\" and cartState=\"Frozen\"",
      "expand": [
        "lineItems[*].custom",
        "lineItems[*].variant.custom",
        "lineItems[*].categories[*].custom",
        "lineItems[*].categories[*].parent.custom",
        "shippingInfo.shippingMethod.custom",
        "shipping[*].shippingInfo.shippingMethod.custom",
        "custom"
      ]
    }
  ],
  "timeoutInMs": 2000
}