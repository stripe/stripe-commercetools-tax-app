# G E N E R A L   C O N F I G U R A T I O N
# Commercetools configuration
CTP_CLIENT_ID=your_24_character_client_id_here
CTP_CLIENT_SECRET=your_32_character_client_secret_here
CTP_PROJECT_KEY=your_project_key_here
CTP_SCOPE=your_scope_here
CTP_REGION=your_region_here

# Stripe configuration
STRIPE_API_TOKEN=your_stripe_api_token_here

#C U S T O M   T Y P E S   C O N F I G U R A T I O N
CUSTOM_TYPE_PRODUCT_KEY=connector-stripe-tax-product
CUSTOM_TYPE_CATEGORY_KEY=connector-stripe-tax-category
CUSTOM_TYPE_SHIPPING_KEY=connector-stripe-tax-shipping
CUSTOM_TYPE_CART_KEY=connector-stripe-tax-calculation-reference

# T A X   C A L C U L A T O R   C O N F I G U R A T I O N
# Default behavior for all calculations
TAX_BEHAVIOR_DEFAULT=exclusive

# Country-specific overrides
TAX_BEHAVIOR_COUNTRY_MAPPING='{"US":"exclusive","CA":"exclusive","DE":"inclusive","FR":"inclusive","GB":"inclusive","AU":"inclusive","IT":"inclusive","ES":"inclusive","NL":"inclusive"}'

# Tax Code Mapping Configuration
# JSON mapping of commercetools categories to Stripe tax codes
# Format: {"categories": [{"ctCategory": {"id": "category-id", "key": "category-key"}, "taxCode": "txcd_XXXXXXXX"}, ...]}
# Note: Either "id" or "key" must be present in ctCategory (or both)
# Note: During post-deploy installation, all categories are validated to exist in commercetools
# If a category does not exist, the connector installation will fail with an error
# Example:
TAX_CODE_CATEGORY_MAPPING_JSON='{"categories": [{"ctCategory": {"key": "books"}, "taxCode": "txcd_10000000"}, {"ctCategory": {"key": "digital-products"}, "taxCode": "txcd_10401000"}, {"ctCategory": {"key": "clothing"}, "taxCode": "txcd_20030000"}, {"ctCategory": {"key": "food"}, "taxCode": "txcd_30070000"}]}'

# Ship-from required
SHIP_FROM_REQUIRED=true

# Default ship-from
SHIP_FROM_DEFAULT_BUSINESS_COUNTRY=US
SHIP_FROM_DEFAULT_BUSINESS_STATE=NY
SHIP_FROM_DEFAULT_BUSINESS_CITY=New York
SHIP_FROM_DEFAULT_BUSINESS_POSTAL_CODE=10001
SHIP_FROM_DEFAULT_BUSINESS_LINE1=123 Main Street
SHIP_FROM_DEFAULT_BUSINESS_LINE2=Suite 100

# Channel priority
SHIP_FROM_CHANNEL_PRIORITY=channel-id-1,channel-id-2,channel-id-3

# Connect Service URL (set automatically during deployment) this value come from commercetools
#CONNECT_SERVICE_URL=https://your-connector-url.com 

# A D D R E S S   V A L I D A T I O N   C O N F I G U R A T I O N
# Default Stripe verification currency
ADDRESS_VALIDATION_STRIPE_DEFAULT_CURRENCY=usd